        <button class="btn btn-sm btn-outline-primary" data-action="create-token" data-token-name="Food" data-token-type="Artifact" data-player="opponent" aria-label="Create Food token for opponent">🍎 Food</button>
        <button class="btn btn-sm btn-outline-primary" data-action="create-token" data-token-name="Map" data-token-type="Artifact" data-player="opponent" aria-label="Create Map token for opponent">🗺️ Map</button>
        <button class="btn btn-sm btn-outline-primary" data-action="create-token" data-token-name="Powerstone" data-token-type="Artifact" data-player="opponent" aria-label="Create Powerstone token for opponent">💠 Powerstone</button>
    </div>
  </section>
  <section>
    <h4>Creature Tokens</h4>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px;">
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="1/1 Soldier" data-token-type="Creature — Soldier" data-player="opponent" aria-label="Create 1/1 Soldier token for Player 2">⚔️ 1/1 Soldier</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="2/2 Zombie" data-token-type="Creature — Zombie" data-player="opponent" aria-label="Create 2/2 Zombie token for Player 2">🧟 2/2 Zombie</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="1/1 Goblin" data-token-type="Creature — Goblin" data-player="opponent" aria-label="Create 1/1 Goblin token for opponent">👹 1/1 Goblin</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="1/1 Elf" data-token-type="Creature — Elf" data-player="opponent" aria-label="Create 1/1 Elf token for opponent">🧝 1/1 Elf</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="3/3 Beast" data-token-type="Creature — Beast" data-player="opponent" aria-label="Create 3/3 Beast token for opponent">🐻 3/3 Beast</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="4/4 Angel" data-token-type="Creature — Angel" data-player="opponent" aria-label="Create 4/4 Angel token for opponent">👼 4/4 Angel</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="5/5 Dragon" data-token-type="Creature — Dragon" data-player="opponent" aria-label="Create 5/5 Dragon token for opponent">🐉 5/5 Dragon</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="1/1 Spirit" data-token-type="Creature — Spirit" data-player="opponent" aria-label="Create 1/1 Spirit token for opponent">👻 1/1 Spirit</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="2/2 Knight" data-token-type="Creature — Knight" data-player="opponent" aria-label="Create 2/2 Knight token for opponent">🛡️ 2/2 Knight</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="create-token" data-token-name="1/1 Insect" data-token-type="Creature — Insect" data-player="opponent" aria-label="Create 1/1 Insect token for opponent">🐛 1/1 Insect</button>
    </div>
  </section>
</aside>
<aside id="playerAdvancedActionsPanel" class="action-panel">
  <header>
    <h3>⚡ Advanced Actions</h3>
    <button class="close-panel" data-action="close-panel" data-panel-id="playerAdvancedActionsPanel" aria-label="Close advanced actions panel">×</button>
  </header>
  <section>
    <button class="btn btn-sm btn-outline-success w-100 mb-2 text-left" data-action="evolving-wilds" data-player="player" data-close-panel="playerAdvancedActionsPanel" style="padding: 8px; text-align: left;" aria-label="Fetch land and close panel">🌍 Fetch Land</button>
    <button class="btn btn-sm btn-outline-success w-100 mb-2 text-left" data-action="cultivate" data-player="player" data-close-panel="playerAdvancedActionsPanel" style="padding: 8px; text-align: left;" aria-label="Ramp and close panel">🌱 Ramp</button>
    <button class="btn btn-sm btn-outline-success w-100 text-left" data-action="cascade" data-player="player" data-close-panel="playerAdvancedActionsPanel" style="padding: 8px; text-align: left;" aria-label="Trigger cascade and close panel">⚡ Cascade</button>
  </section>
</aside>
<aside id="opponentAdvancedActionsPanel" class="action-panel">
  <header>
    <h3>⚡ Opponent's Advanced</h3>
    <button class="close-panel" data-action="close-panel" data-panel-id="opponentAdvancedActionsPanel" aria-label="Close opponent advanced actions panel">×</button>
  </header>
  <section>
    <button class="btn btn-sm btn-outline-success w-100 mb-2 text-left" data-action="evolving-wilds" data-player="opponent" data-close-panel="opponentAdvancedActionsPanel" style="padding: 8px; text-align: left;" aria-label="Opponent fetch land and close panel">🌍 Fetch Land</button>
    <button class="btn btn-sm btn-outline-success w-100 mb-2 text-left" data-action="cultivate" data-player="opponent" data-close-panel="opponentAdvancedActionsPanel" style="padding: 8px; text-align: left;" aria-label="Opponent ramp and close panel">🌱 Ramp</button>
    <button class="btn btn-sm btn-outline-success w-100 text-left" data-action="cascade" data-player="opponent" data-close-panel="opponentAdvancedActionsPanel" style="padding: 8px; text-align: left;" aria-label="Opponent trigger cascade and close panel">⚡ Cascade</button>
  </section>
</aside>
</body>
